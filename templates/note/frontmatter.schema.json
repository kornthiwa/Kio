{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kio.local/schemas/note-frontmatter.json",
  "title": "Kio note role-file YAML frontmatter",
  "type": "object",
  "required": ["date", "role", "status", "us_ids", "note_folder"],
  "properties": {
    "topic": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "role": { "type": "string", "enum": ["ba", "sa", "dev", "qa"] },
    "status": { "type": "string", "enum": ["draft", "ready", "blocked"] },
    "us_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Prefer US-n. Empty array allowed for consults without BA stories."
    },
    "bo_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Optional. BA business objectives (BO-n). Same IDs as the brief. Omit on older notes."
    },
    "br_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Optional. BA business requirements (BR-n). Not business rules (those are RULE-n in the body)."
    },
    "note_folder": { "type": "string" },
    "recommendation": {
      "type": ["string", "null"],
      "enum": ["ship", "ship_with_risk", "no_ship", null],
      "description": "QA only; omit or null for BA/SA/Dev"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "role": { "const": "qa" } } },
      "then": {
        "properties": {
          "recommendation": {
            "type": ["string", "null"],
            "enum": ["ship", "ship_with_risk", "no_ship", null]
          }
        }
      }
    }
  ]
}
