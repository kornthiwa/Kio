{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kio.local/schemas/note-manifest.json",
  "title": "Kio note topic manifest",
  "type": "object",
  "required": ["date", "note_folder", "updated_at", "us_ids", "roles"],
  "properties": {
    "$schema": { "type": "string" },
    "topic": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note_folder": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" },
    "us_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Prefer US-n (e.g. US-1). Empty array allowed for consults without BA stories."
    },
    "tldr": { "type": "string" },
    "recommendation": {
      "type": ["string", "null"],
      "enum": ["ship", "ship_with_risk", "no_ship", null]
    },
    "roles": {
      "type": "object",
      "required": ["ba", "sa", "qa"],
      "properties": {
        "ba": { "$ref": "#/$defs/roleEntry" },
        "sa": { "$ref": "#/$defs/roleEntry" },
        "qa": { "$ref": "#/$defs/roleEntry" }
      }
    }
  },
  "$defs": {
    "roleEntry": {
      "type": "object",
      "required": ["file", "status"],
      "properties": {
        "file": { "type": "string" },
        "status": {
          "type": ["string", "null"],
          "enum": ["draft", "ready", "blocked", null]
        }
      }
    }
  }
}
